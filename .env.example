# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------
# PostgreSQL
# The app connects with a dedicated role scoped to charada_db,
# never the server superuser.
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/charada_db?sslmode=disable

# QvaPay App credentials (developer panel -> your App)
# app-secret is server-only. It must never reach the WebView.
QVAPAY_APP_ID=
QVAPAY_APP_SECRET=

# Public base URL of this mini-app (https, no trailing slash).
# Must match the entry URL configured in the QvaPay developer panel.
PUBLIC_BASE_URL=

# Session signing secret for our own user sessions (random, 32+ bytes hex).
SESSION_SECRET=

# Telegram delivery (premium feature). Optional until enabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Daily adivinanza (the riddle of the day). Any provider that speaks the
# OpenAI chat completions API: OpenAI, DeepSeek, Groq, OpenRouter, Ollama...
# The key stays on the server and never reaches the WebView.
ADIVINANZA_LLM_BASE_URL=https://api.openai.com/v1
ADIVINANZA_LLM_MODEL=
ADIVINANZA_LLM_API_KEY=
# Optional: milliseconds to wait for an answer (default 30000).
# ADIVINANZA_LLM_TIMEOUT_MS=
